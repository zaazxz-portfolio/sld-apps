# Git / VCS
.git
.gitignore

# Docker files (tidak perlu di dalam image)
.dockerignore
compose.yaml
compose.override.yaml

# Environment & secrets
.env
.env.*
!.env.example

# Editor & IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

