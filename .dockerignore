*.sqlite
*.sqlite3

# Uploads / storage yang besar
storage/
uploads/

# Cache & build artifacts
cache/
tmp/
temp/

# Composer vendor (jika nanti dipakai)
vendor/

# Node modules (jika nanti ada asset build)
node_modules/

# Context folder (sudah ada di .dockerignore sebelumnya)
context/