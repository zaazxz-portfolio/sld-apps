# Salin file ini menjadi .env lalu sesuaikan nilainya
# cp .env.example .env

# -------------------------------------------------------
# App
# -------------------------------------------------------
# Port host untuk akses app (http://localhost:8080)
APP_PORT=8080
APP_ENV=development
APP_DEBUG=true

# -------------------------------------------------------
# Database driver: sqlite | mysql
# -------------------------------------------------------
DB_DRIVER=sqlite

# --- SQLite ---
DB_SQLITE_PATH=/var/www/html/database.db

# --- MySQL (aktif saat pakai --profile mysql) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=sld_apps
DB_USER=sld_user
DB_PASS=secret

MYSQL_PORT=33062
MYSQL_ROOT_PASSWORD=password
