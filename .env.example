# Salin file ini menjadi .env lalu sesuaikan nilainya
# cp .env.example .env

# -------------------------------------------------------
# App
# -------------------------------------------------------
# Port host untuk akses app (http://localhost:8080)
APP_PORT=8080
APP_ENV=development
APP_DEBUG=true

# -------------------------------------------------------
# Database (SQLite only)
# -------------------------------------------------------
DB_DRIVER=sqlite
DB_SQLITE_PATH=/var/www/html/database.db

# -------------------------------------------------------
# 9Router AI (diisi via halaman UI: Pengaturan API 9Router)
# -------------------------------------------------------
# Setelah isi lewat UI, nilai ini tersimpan di database.db (table: settings)
# AI_MODEL default: coding
# AI URL contoh: https://api.9router.com
